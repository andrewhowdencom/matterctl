[Unit]
Description=OpenThread Border Router for SkyConnect
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=otbr
Image=docker.io/openthread/border-router:stable
Pull=never
Network=host
AddCapability=NET_ADMIN
AddCapability=NET_RAW
AddDevice=/dev/net/tun
AddDevice=/dev/serial/by-id/usb-Nabu_Casa_SkyConnect_v1.0_46a2cdf7bc96ed11b7bcc498a7669f5d-if00-port0:/dev/ttyUSB0
Volume=/var/lib/otbr:/data
Environment=OT_RCP_DEVICE=spinel+hdlc+uart:///dev/ttyUSB0?uart-baudrate=460800&uart-flow-control
Environment=OT_INFRA_IF=wlo1
Environment=OT_THREAD_IF=wpan0
Environment=OT_REST_LISTEN_ADDR=127.0.0.1
Environment=OT_REST_LISTEN_PORT=8082
Environment=OT_WEB_LISTEN_ADDR=127.0.0.1
Environment=OT_WEB_LISTEN_PORT=8083
Environment=OT_LOG_LEVEL=4

[Service]
Restart=on-failure
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
